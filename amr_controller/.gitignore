# ---------------------------------------------------------------------------
# AMR Controller — Flutter client for the AMR robot
#
# Flutter is not installed in this repository's environment, so the
# platform/ and per-platform boilerplate (android/, ios/, macos/, windows/,
# web/, plus the generated _plugin_ registrants) is created by flutter itself:
#
#     cd amr_controller
#     flutter create --platforms=macos,windows,android,ios .
#
# that command fills in the machine-generated runners *around* this committed
# lib/ + pubspec.yaml and wires every dependency's native half. This
# directory intentionally ships only the hand-authored source below, because
# the runners are ~100k lines of version-pinned generated code that drifts the
# moment the SDK revs.
#
#     lib/main.dart                            app entry, theme, router
#     lib/models/app_state.dart                application + robot data models
#     lib/services/robot_api_service.dart      REST client (http package)
#     lib/providers/robot_provider.dart        state (provider/ChangeNotifier)
#     lib/screens/connection_screen.dart       host/port + ping + auto-reconnect
#     lib/screens/applications_hub_screen.dart  24-card hub from /applications/state
#     lib/screens/teleop_screen.dart           joystick + live telemetry
#     lib/widgets/app_card.dart                one hub card
#     lib/widgets/joystick_widget.dart         pointer-driven virtual joystick
#     lib/theme/theme.dart                     slate/cyan palette + status colours
# ---------------------------------------------------------------------------

# The compiled app lives only in build/ (git-ignored below).

# Dart toolchain
.dart_tool/
.packages
build/
pubspec.lock
*.g.dart

# Flutter / Dart plugin registrants — regenerated by `flutter pub get`
.metadata
.flutter-plugins
.flutter-plugins-dependencies

# Android
android/.gradle/
android/local.properties
android/app/.cxx/

# iOS / macOS
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Pods/
macos/Flutter/ephemeral/
.ios/

# Windows
windows/flutter/ephemeral/

# Editors
.idea/
.vscode/
*.iml
.DS_Store